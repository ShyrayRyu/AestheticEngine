# =============================================================================
# Variables d'environnement - AestheticEngine
# =============================================================================

# URL du serveur Ollama tournant sur la machine hôte (ou LXC)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=llava:latest

# Seuil par défaut de sélection des segments d'effort physique (1.0 à 10.0)
MIN_EFFORT_SCORE=7.0

# URLs exposées au Frontend Vite
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
